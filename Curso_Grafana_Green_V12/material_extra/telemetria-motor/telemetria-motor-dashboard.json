  "title": "Telemetria do motor (simulada)",
  "uid": "telemetria-motor-sim",
  "tags": [
    "telemetria",
    "carro",
    "curso-grafana",
    "simulado"
  ],
  "description": "Telemetria simulada de um motor: rpm, velocidade, temperaturas, pressão do óleo, consumo e códigos de falha.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "veiculo",
        "label": "Veículo",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(car_engine_rpm, veiculo)",
          "refId": "v"
        },
        "definition": "label_values(car_engine_rpm, veiculo)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Sobre este dashboard",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Telemetria **simulada** de um motor (script `simulador.py`, métricas `car_*`). O ciclo dura 10 min: parado, arrancada, cruzeiro, ultrapassagem e freada. A cada 20 min há um **defeito de superaquecimento** que dispara os códigos P0217 e P0524. Todas as séries são *gauges*, exceto `car_distance_km_total` e `car_fuel_used_liters_total`, que são *counters* (use `rate()` e `increase()` nelas)."
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Rotação (rpm)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "car_engine_rpm{veiculo=\"$veiculo\"}",
          "legendFormat": "",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 7000,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5000
              },
              {
                "color": "red",
                "value": 6200
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
