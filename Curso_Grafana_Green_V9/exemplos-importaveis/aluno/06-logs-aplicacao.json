{
  "title": "Green - 06 - Logs da aplicação",
  "description": "LogQL seleciona o arquivo do Grafana News. Expanda as linhas para examinar os detalhes.",
  "schemaVersion": 41,
  "editable": true,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Logs do Grafana News",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{filename=\"/var/log/tns-app.log\"}",
          "refId": "A",
          "editorMode": "code",
          "queryType": "range",
          "maxLines": 1000
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 15
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "pluginVersion": "12.0.1"
    }
  ],
  "links": [],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "5s",
  "timezone": "browser",
  "graphTooltip": 1,
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Selecione a fonte de dados já conectada ao seu laboratório.",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "12.0.1"
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "logs",
      "name": "logs",
      "version": ""
    }
  ],
  "id": null,
  "uid": null,
  "version": 1,
  "tags": [
    "curso-green",
    "modelo-opcional"
  ]
}
