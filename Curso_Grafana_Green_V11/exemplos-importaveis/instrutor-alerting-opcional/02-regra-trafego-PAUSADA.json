{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "green-modelos-10s",
      "folder": "Green - Modelos opcionais",
      "interval": "10s",
      "rules": [
        {
          "uid": "green-trafego-relevante-pausado",
          "title": "Green - Tráfego relevante (modelo PAUSADO)",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "PBFA97CFB590B2093",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "PBFA97CFB590B2093"
                },
                "editorMode": "code",
                "expr": "sum by (route) (rate(tns_request_duration_seconds_count{route!~\"^/?metrics$\"}[5m]))",
                "instant": false,
                "range": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "queryType": "",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "type": "reduce",
                "reducer": "last",
                "conditions": [
                  {
                    "evaluator": {
                      "params": [],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "queryType": "",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "B",
                "type": "threshold",
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        0.01
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "C"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "C"
              }
            }
          ],
          "noDataState": "NoData",
          "execErrState": "Error",
          "for": "0s",
          "isPaused": true,
          "annotations": {
            "summary": "Modelo didático: tráfego por rota acima de 0,01 req/s.",
            "description": "A Range exclui metrics; B Reduce Last; C Threshold. O arquivo é distribuído pausado."
          },
          "labels": {
            "curso": "green",
            "ambiente": "laboratorio"
          },
          "notification_settings": {
            "receiver": "Green - Webhook local (modelo opcional)"
          }
        }
      ]
    }
  ]
}
