        "h": 9,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds}"
          },
          "expr": "{service=\"ecommerce-shop\"} |= \"Gateway\"",
          "queryType": "range",
          "editorMode": "code"
