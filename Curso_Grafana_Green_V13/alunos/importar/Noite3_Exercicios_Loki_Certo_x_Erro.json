      "datasource": {
        "type": "loki",
        "uid": "${ds}"
      },
      "description": "Funções de range precisam da janela entre colchetes. count_over_time conta linhas na janela; rate divide pelos segundos da janela.",
      "gridPos": {
        "h": 9,
        "w": 12,
