      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds}"
          },
          "expr": "{service=\"ecommerce-shop\"} | json | line_format \"{{.level}} {{.endpoint}} {{.msg}}\"",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "type": "logs",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showLabels": false,
        "showCommonLabels": false
