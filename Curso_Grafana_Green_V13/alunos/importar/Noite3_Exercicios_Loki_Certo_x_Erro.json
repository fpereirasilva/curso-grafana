      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds}"
          },
          "expr": "{service=\"ecommerce-shop\"} |= \"error\"",
          "queryType": "range",
          "editorMode": "code"
        }
