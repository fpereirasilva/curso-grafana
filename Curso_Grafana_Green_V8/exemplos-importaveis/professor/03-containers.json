  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "CPU por container (top 5)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "topk(5, rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]) * 100)",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "description": "topk é avaliado em cada instante; o intervalo inteiro pode mostrar mais de cinco nomes na legenda. CPU de 100% equivale a um núcleo e pode ultrapassar 100%."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "Memória por container (top 5)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "topk(5, container_memory_usage_bytes{name!=\"\"})",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "description": "topk é avaliado em cada instante; o intervalo inteiro pode mostrar mais de cinco nomes na legenda. CPU de 100% equivale a um núcleo e pode ultrapassar 100%."
