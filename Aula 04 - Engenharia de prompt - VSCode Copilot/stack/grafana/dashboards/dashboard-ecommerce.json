      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus-datasource-lab" }, "expr": "sum(rate(http_requests_total{service=\"ecommerce-lab\"}[1m])) by (status)", "legendFormat": "Status {{status}}", "refId": "A" }
