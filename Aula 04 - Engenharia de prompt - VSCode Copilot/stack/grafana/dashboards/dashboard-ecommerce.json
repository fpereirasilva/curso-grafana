      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus-datasource-lab" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"ecommerce-lab\"}[1m])))", "legendFormat": "p95", "refId": "A" },
